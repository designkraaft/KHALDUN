      let list = all;

      if (filterType !== 'all') {
          list = list.filter(r => r.category === filterType);
      }

      // خوارزمية الفرز (ترتيب السجلات)
      list.sort((a, b) => {
          if (sortType === 'date') {
              return b.id - a.id; // تنازلي حسب التاريخ (ID هو Date.now)
          } else {
              // تجميع حسب المساق أبجدياً، ثم داخل كل مساق تنازلياً حسب التاريخ
              const trackA = a.track || '';
              const trackB = b.track || '';
              if (trackA < trackB) return -1;
              if (trackA > trackB) return 1;
              return b.id - a.id;
          }
      });

      tbody.innerHTML = '';
      if (list.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding: 30px; color: var(--text-dim); font-weight:700;">لا توجد سجلات بعد.</td></tr>`;
