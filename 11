    function stepVal(elemId, delta) {
      const el = document.getElementById(elemId);
      if (el) {
        let v = parseInt(el.value) || 0;
        v = Math.max(0, v + delta);
        el.value = v;
        updateEntryPreview();
      }
    }

    // دالة مساعدة لتحديد متوسط الكلمات (WPM) حسب نوع المساق
    function getTrackWPMMultiplier(trackName) {
        if (!trackName) return 128;
        if (trackName.includes('المواد الدراسية')) return 235; // معدل المادة العلمية (بين 220-250)
        if (trackName.includes('القرآن')) return 128; // القرآن الكريم
        return 128;
    }

    // دالة مساعدة لتحديد Badge اللون المخصص لكل مساق
    function getTrackBadgeClass(trackName) {
        if (!trackName) return 'badge-track-old';
        if (trackName.includes('القرآن')) return 'badge-track-quran';
        if (trackName.includes('الحديث')) return 'badge-track-hadith';
        if (trackName.includes('اللغات')) return 'badge-track-lang';
        if (trackName.includes('المواد الدراسية')) return 'badge-track-study';
        if (trackName.includes('المتون')) return 'badge-track-mutoon';
        if (trackName.includes('الشعر')) return 'badge-track-poetry';
        return 'badge-track-old';
    }

    function updateEntryPreview() {
      const cat = document.getElementById('selCategory').value;
      const track = document.getElementById('selTrack').value;
      const m1 = document.getElementById('previewMetric1');
      const m2 = document.getElementById('previewMetric2');

      if (cat === 'reading') {
        const pages = parseInt(document.getElementById('inPages')?.value) || 0;
        
        const avgWords = getTrackWPMMultiplier(track);
        const wpm = Math.round((pages * avgWords) / 10);
        
        m1.innerText = `السرعة: ~${wpm} كلمة/دقيقة | قراءة ${pages} صفحة بـ 10د`;
        m2.innerText = pages >= 50 ? 'مستوى متقدم 🔥' : 'مستوى تمهيدي';
        m2.className = 'badge info';
      } else if (cat === 'barrier') {
        const errors = parseInt(document.getElementById('inErrors')?.value) || 0;
        const actTime = parseInt(document.getElementById('inActTime')?.value) || 5;
        const bName = document.getElementById('inBarrierName')?.value || '';
        
        const barrierObj = ALL_12_BARRIERS.find(b => bName.includes(b.shortName) || bName === b.name);
        const targetMins = barrierObj ? barrierObj.targetMins : 999;
        
        const acc = Math.max(0, 100 - (errors * 5));
        const passedAcc = acc >= 90;
        const passedTime = actTime <= targetMins;
        
        const passed = passedAcc && passedTime;
        const mult = actTime > 0 ? Math.round(360 / actTime) : 0;
        
        if (!passedTime) {
            m1.innerText = `فشل بسبب الوقت: ${actTime}د > ${targetMins}د المستهدفة`;
            m2.innerText = 'تجاوز للوقت (فاشلة) ⚠️';
            m2.className = 'badge danger';
        } else if (!passedAcc) {
            m1.innerText = `فشل بسبب الإتقان: ${acc}% (المطلوب 90%+)`;
            m2.innerText = 'يحتاج إعادة ⚠️';
            m2.className = 'badge warning';
        } else {
            m1.innerText = `إتقان: ${acc}% | وقت ممتاز | مضاعفة: ${mult} ضعف`;
            m2.innerText = 'مقبول وناجح ✅';
            m2.className = 'badge success';
        }
      } else {
        m1.innerText = 'جاهز للتثبيت في السجل';
        m2.innerText = 'نشاط تدريبي';
        m2.className = 'badge neutral';
      }
    }

    function commitEntry() {
      const cat = document.getElementById('selCategory').value;
      const track = document.getElementById('selTrack').value;
      const today = getTodayDateStr();
      const timeStr = new Date().toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });

      let record = {
        id: Date.now(),
        date: today,
        time: timeStr,
        category: cat,
        track: track
      };

      if (cat === 'reading') {
        const pages = parseInt(document.getElementById('inPages')?.value) || 0;
        const thoughts = parseInt(document.getElementById('inThoughts')?.value) || 0;
        record.pages = pages;
        record.thoughts = thoughts;
        
        const avgWords = getTrackWPMMultiplier(track);
        const wpm = Math.round((pages * avgWords) / 10);
        
        record.details = `جولة 10د (${pages} ص) - ~${wpm} ك/د`;
        record.qty = pages;
      } else if (cat === 'barrier') {
        const bName = document.getElementById('inBarrierName')?.value || 'حاجز';
        const actTime = parseInt(document.getElementById('inActTime')?.value) || 5;
        const errors = parseInt(document.getElementById('inErrors')?.value) || 0;
        
        const barrierObj = ALL_12_BARRIERS.find(b => bName.includes(b.shortName) || bName === b.name);
        const targetMins = barrierObj ? barrierObj.targetMins : 999;
        
        const acc = Math.max(0, 100 - (errors * 5));
        const passedAcc = acc >= 90;
        const passedTime = actTime <= targetMins;
        const passed = passedAcc && passedTime;
        
        const mult = actTime > 0 ? Math.round(360 / actTime) : 0;

        record.barrierName = bName;
        record.actTime = actTime;
        record.errors = errors;
        record.accuracy = acc;
        record.status = passed ? 'مقبول' : 'يحتاج إعادة'; // يحتاج إعادة للاثنين (إما وقت أو إتقان)
        record.multiplier = mult;
        record.details = `${bName} (نفذ بـ ${actTime}د)`;
        record.qty = 1;
      } else if (cat === 'words_study') {
        const words = parseInt(document.getElementById('inWords')?.value) || 0;
        record.words = words;
        record.details = `حفظ كلمات/مقررات (${words})`;
        record.qty = words;
      } else if (cat === 'diag') {
        const dNum = document.getElementById('inDiagNum')?.value || '1';
        const dVal = parseInt(document.getElementById('inDiagVal')?.value) || 0;
        record.diagNum = dNum;
        record.diagVal = dVal;
        record.details = `فحص تكميلي المقياس ${dNum} (${dVal})`;
        record.qty = dVal;
      }

      const db = getDB();
      db.unshift(record); // newest at start
      saveDB(db);
      showToast('تم تثبيت الجلسة بنجاح!');
    }

    function renderTodayTable() {
      const tbody = document.getElementById('todayTableBody');
      const tfoot = document.getElementById('todayTableFoot');
      const badge = document.getElementById('todayRoundsBadge');
      const dateLbl = document.getElementById('todayDateLabel');
      const outcomeBox = document.getElementById('todayOutcomeSection');
      if (!tbody) return;

      const today = getTodayDateStr();
      if (dateLbl) dateLbl.innerText = today;

      const all = getDB();
      const todayRecords = all.filter(r => r.date === today);
      if (badge) badge.innerText = `${todayRecords.length} جولات مسجلة اليوم`;

      tbody.innerHTML = '';
      if (todayRecords.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding: 30px; color: var(--text-dim); font-weight:700;">لم يتم تسجيل أي جولات اليوم بعد. اختر النشاط واضغط تثبيت.</td></tr>`;
        if (tfoot) tfoot.innerHTML = '';
        if (outcomeBox) outcomeBox.innerHTML = '<div style="color: var(--text-dim); text-align: center; font-size: 14px;">لا توجد حصيلة مسجلة لهذا اليوم بعد.</div>';
        return;
      }

      let totalQuranPages = 0;
      let totalStudyPages = 0;
      let totalWords = 0;
      const trackSummary = {};

      const trackMax = {};
      const reversedRecords = [...todayRecords].reverse(); 
      
      reversedRecords.forEach(r => {
          if (r.category === 'reading') {
              let currentMax = trackMax[r.track] || 0;
              r.deltaFromMax = r.pages - currentMax;
              r.prevMax = currentMax;
              if (r.pages > currentMax) {
                  trackMax[r.track] = r.pages;
              }
          }
      });

      todayRecords.forEach((r, idx) => {
        let deltaHtml = '<span class="delta-meter delta-eq">-</span>';
        
        if (r.category === 'reading') {
          if (r.prevMax === 0) {
              deltaHtml = `<span class="delta-meter delta-eq">أول جولة (أساس)</span>`;
          } else {
              if (r.deltaFromMax > 0) deltaHtml = `<span class="delta-meter delta-up">+${r.deltaFromMax} ص أعلى إنجاز 🏆</span>`;
              else if (r.deltaFromMax < 0) deltaHtml = `<span class="delta-meter delta-down">${Math.abs(r.deltaFromMax)} ص عن القمة ⬇️</span>`;
              else deltaHtml = `<span class="delta-meter delta-eq">ثبات في القمة ⭐️</span>`;
          }
        }

        if (r.track && r.track.includes('القرآن') && r.pages) totalQuranPages += r.pages;
        if (r.track && r.track.includes('المواد الدراسية') && r.pages) totalStudyPages += r.pages;
        if (r.words) totalWords += r.words;

        const trk = r.track || 'مساق عام';
        if (!trackSummary[trk]) {
          trackSummary[trk] = { readingRounds: 0, readingPages: 0, wordsTotal: 0, wordsRounds: 0, barriersCount: 0, otherCount: 0 };
        }
        if (r.category === 'reading') {
          trackSummary[trk].readingRounds++;
          trackSummary[trk].readingPages += (r.pages || 0);
        } else if (r.category === 'words_study') {
          trackSummary[trk].wordsRounds++;
          trackSummary[trk].wordsTotal += (r.words || 0);
        } else if (r.category === 'barrier') {
          trackSummary[trk].barriersCount++;
        } else {
          trackSummary[trk].otherCount++;
        }

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td style="text-align:center; font-family: monospace; font-weight: bold;">${todayRecords.length - idx}</td>
          <td><span class="badge ${getCategoryBadgeClass(r.category)}">${getCategoryName(r.category)}</span></td>
