    // --- تصدير PDF مخصص ---
    function exportTableToPDF(tableId, title) {
        const table = document.getElementById(tableId);
        if (!table) return;

        const opt = {
            margin:       [10, 10, 10, 10], // top, left, bottom, right
            filename:     `${title}_${getTodayDateStr().replace(/\//g,'-')}.pdf`,
            image:        { type: 'jpeg', quality: 0.98 },
            html2canvas:  { scale: 2, useCORS: true },
            jsPDF:        { unit: 'mm', format: 'a4', orientation: 'landscape' }
        };
        
        // غلاف مخصص للملف يحتوي على التنسيقات (كي لا يظهر بالوضع الليلي الأسود في الطباعة)
        const wrap = document.createElement('div');
        wrap.style.padding = '20px';
        wrap.style.backgroundColor = '#ffffff';
        wrap.style.color = '#000000';
        wrap.style.direction = 'rtl';
        wrap.style.fontFamily = 'Arial, sans-serif';
        
        const header = document.createElement('h2');
        header.innerText = title;
        header.style.textAlign = 'center';
        header.style.marginBottom = '20px';
        header.style.color = '#1f2937';
        wrap.appendChild(header);

        // استنساخ الجدول وإزالة عامود "الإجراءات/الحذف"
        const tableClone = table.cloneNode(true);
        tableClone.style.width = '100%';
        tableClone.style.borderCollapse = 'collapse';
        
        const ths = tableClone.querySelectorAll('th.hide-in-pdf');
        ths.forEach(th => th.remove());
        
        const trs = tableClone.querySelectorAll('tbody tr');
        trs.forEach(tr => {
            const tds = tr.querySelectorAll('td');
            if (tds.length > 0) tds[tds.length - 1].remove(); // إزالة زر الحذف
            
            tr.style.borderBottom = '1px solid #e5e7eb';
            tds.forEach(td => {
                td.style.padding = '10px';
                td.style.fontSize = '12px';
            });
        });

        // تنظيف ألوان الـ Badges لتكون مقروءة على خلفية بيضاء
        const badges = tableClone.querySelectorAll('.badge');
        badges.forEach(b => {
            b.style.border = '1px solid #ccc';
            b.style.color = '#111';
            b.style.background = '#f3f4f6';
        });

        wrap.appendChild(tableClone);
        
        html2pdf().set(opt).from(wrap).save().then(() => {
            showToast('تم تصدير ملف PDF بنجاح!');
        });
    }

    function exportTableToCSV(tableId, filenamePrefix) {
        const table = document.getElementById(tableId);
        if (!table) return;

        let csv = '\uFEFF'; 
        const rows = table.querySelectorAll('tr');
        
        for (let i = 0; i < rows.length; i++) {
            let row = [], cols = rows[i].querySelectorAll('td:not(.hide-in-pdf), th:not(.hide-in-pdf)');
            for (let j = 0; j < cols.length; j++) {
                let data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/"/g, '""');
                row.push('"' + data + '"');
            }
            if (row.length > 0) csv += row.join(',') + '\n';
        }

        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `${filenamePrefix}_${getTodayDateStr().replace(/\//g,'-')}.csv`;
        a.click();
    }

    function exportCSVGlobal() {
      const db = getDB();
      if (db.length === 0) {
        showToast('لا توجد بيانات لتصديرها.');
        return;
      }
      let csv = "\uFEFFالتاريخ,الوقت,نوع النشاط,المساق,التفاصيل,الكمية,الحالة,نسبة الإتقان\n";
      db.forEach(r => {
        csv += `"${r.date}","${r.time||''}","${getCategoryName(r.category)}","${r.track||''}","${r.details||''}","${r.qty||0}","${r.status||'-'}","${r.accuracy||100}%"\n`;
      });
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `قاعدة_بيانات_التدريبات_${getTodayDateStr().replace(/\//g,'-')}.csv`;
      a.click();
    }

    /* ==========================================================
       Enhanced Timer Engine
       ========================================================== */
    let timerInterval = null;
    let timerSeconds = 600;
    let originalTotalSeconds = 600;
    let timerTargetEnd = null;
    let timerRunning = false;
    let audioCtx = null;
    let alarmInterval = null;
    let isAlarmActive = false;
    let hasRequestedNotification = false;

    function initAudioContext() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function playBeep() {
      try {
        initAudioContext();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.type = 'square';
        osc.frequency.setValueAtTime(880, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.25, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.35);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.35);
      } catch (e) {
        console.warn('Audio Context error:', e);
      }
    }

    function startContinuousAlarm() {
      if (isAlarmActive) return;
      isAlarmActive = true;

      const banner = document.getElementById('alarmBanner');
      const btnHeader = document.getElementById('btnHeaderStopAlarm');
      if (banner) banner.style.display = 'flex';
      if (btnHeader) btnHeader.style.display = 'inline-flex';

      playBeep();
      alarmInterval = setInterval(() => {
        playBeep();
      }, 700);

      if ("Notification" in window && Notification.permission === "granted") {
        new Notification("منظومة التدريبات العقلية", {
          body: "⏰ انتهى وقت المؤقت المحدد! اضغط لإيقاف التنبيه.",
          icon: "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/svgs/solid/clock.svg"
        });
      }
    }

    function stopAlarm() {
      if (alarmInterval) {
        clearInterval(alarmInterval);
        alarmInterval = null;
      }
      isAlarmActive = false;
      const banner = document.getElementById('alarmBanner');
      const btnHeader = document.getElementById('btnHeaderStopAlarm');
      if (banner) banner.style.display = 'none';
      if (btnHeader) btnHeader.style.display = 'none';
      showToast('تم إيقاف صوت المنبه.');
    }

    function updateTimerLabel() {
      const mins = Math.floor(timerSeconds / 60);
      const secs = timerSeconds % 60;
      const formattedTime = `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;
      
      const display = document.getElementById('globalTimerDisplay');
      if (display) display.innerText = formattedTime;
      
      const fsDisplay = document.getElementById('fullscreenTimerText');
      if (fsDisplay) fsDisplay.innerText = formattedTime;

      updateFullscreenVisuals();
    }

    function updateFullscreenVisuals() {
      const circle = document.getElementById('fullscreenProgressCircle');
      if (!circle) return;
      
      const circumference = 2 * Math.PI * 200;
      circle.style.strokeDasharray = `${circumference} ${circumference}`;
      
      const percent = timerSeconds / (originalTotalSeconds || 1);
      const offset = circumference - (percent * circumference);
      circle.style.strokeDashoffset = offset;

      if (percent > 0.5) circle.style.stroke = "var(--accent-info)";
      else if (percent > 0.2) circle.style.stroke = "var(--accent-warning)";
      else circle.style.stroke = "var(--accent-danger)";
    }

    function openFullscreenTimer() {
      const overlay = document.getElementById('fullscreenTimerOverlay');
      if (overlay) overlay.classList.remove('fullscreen-timer-hidden');
      updateFullscreenVisuals();
    }

    function closeFullscreenTimer() {
      const overlay = document.getElementById('fullscreenTimerOverlay');
      if (overlay) overlay.classList.add('fullscreen-timer-hidden');
    }

    function onTimerPresetChanged() {
      const sel = document.getElementById('selTimerBarrierPreset');
      if (!sel) return;
      const secs = parseInt(sel.value) || 600;
      if (timerRunning) toggleTimer();
      timerSeconds = secs;
      originalTotalSeconds = secs;
      updateTimerLabel();
    }

    function toggleTimer() {
      initAudioContext();
      
      if ("Notification" in window && Notification.permission === "default" && !hasRequestedNotification) {
        Notification.requestPermission();
        hasRequestedNotification = true;
      }

      const btn = document.getElementById('btnTimerControl');
      if (timerRunning) {
        clearInterval(timerInterval);
        timerRunning = false;
        timerTargetEnd = null;
        if (btn) btn.innerHTML = '<i class="fa-solid fa-play"></i> <span>متابعة</span>';
      } else {
        if (timerSeconds <= 0) {
          onTimerPresetChanged();
        }
        timerRunning = true;
        timerTargetEnd = Date.now() + (timerSeconds * 1000);
        if (btn) btn.innerHTML = '<i class="fa-solid fa-pause"></i> <span>إيقاف</span>';

        timerInterval = setInterval(() => {
          const now = Date.now();
          const remaining = Math.round((timerTargetEnd - now) / 1000);

          if (remaining > 0) {
            timerSeconds = remaining;
            updateTimerLabel();
          } else {
            timerSeconds = 0;
            updateTimerLabel();
            clearInterval(timerInterval);
            timerRunning = false;
            timerTargetEnd = null;
            if (btn) btn.innerHTML = '<i class="fa-solid fa-play"></i> <span>بدء</span>';
            startContinuousAlarm();
          }
        }, 500);
      }
    }

    function resetTimer() {
      if (timerRunning) {
        clearInterval(timerInterval);
        timerRunning = false;
        timerTargetEnd = null;
      }
      stopAlarm();
      const sel = document.getElementById('selTimerBarrierPreset');
      timerSeconds = sel ? parseInt(sel.value) : 600;
      originalTotalSeconds = timerSeconds;
      const btn = document.getElementById('btnTimerControl');
      if (btn) btn.innerHTML = '<i class="fa-solid fa-play"></i> <span>بدء</span>';
      updateTimerLabel();
    }

    document.addEventListener("visibilitychange", () => {
      if (timerRunning && timerTargetEnd) {
        const now = Date.now();
        const remaining = Math.round((timerTargetEnd - now) / 1000);
        if (remaining <= 0) {
          timerSeconds = 0;
          updateTimerLabel();
          clearInterval(timerInterval);
          timerRunning = false;
          timerTargetEnd = null;
          const btn = document.getElementById('btnTimerControl');
          if (btn) btn.innerHTML = '<i class="fa-solid fa-play"></i> <span>بدء</span>';
          startContinuousAlarm();
        } else {
          timerSeconds = remaining;
          updateTimerLabel();
        }
      }
    });

    function deleteRecord(id) {
      const db = getDB().filter(r => r.id !== id);
      saveDB(db);
      showToast('تم حذف السجل المحدد.');
    }

    function exportJSONBackup() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(getDB(), null, 2));
      const a = document.createElement('a');
      a.href = dataStr;
      a.download = `mental_training_backup_${getTodayDateStr().replace(/\//g,'-')}.json`;
      a.click();
    }

    function importJSONBackup(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const imported = JSON.parse(e.target.result);
          if (Array.isArray(imported)) {
            saveDB(imported);
            showToast('تمت استعادة النسخة الاحتياطية بنجاح!');
          }
        } catch (err) {
          showToast('الملف غير صالح.');
        }
      };
      reader.readAsText(file);
    }

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem(THEME_KEY, next);
      const btn = document.getElementById('themeToggleBtn');
      if (btn) btn.innerHTML = next === 'dark' ? '<i class="fa-solid fa-sun"></i> <span>الوضع النهاري</span>' : '<i class="fa-solid fa-moon"></i> <span>الوضع الليلي</span>';
    }

    function getCategoryName(cat) {
      const map = { reading: 'جولة قراءة 10د', barrier: 'كسر حاجز', words_study: 'حفظ كلمات/مقررات', diag: 'فحص تكميلي' };
      return map[cat] || cat;
    }
    function getCategoryBadgeClass(cat) {
      const map = { reading: 'info', barrier: 'warning', words_study: 'neutral', diag: 'neutral' };
      return map[cat] || 'neutral';
    }

    function showToast(msg) {
      let toast = document.getElementById('globalToast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'globalToast';
        toast.style.cssText = 'position:fixed; bottom:20px; left:50%; transform:translateX(-50%); background:#1e2433; color:#fff; padding:12px 24px; border-radius:10px; border:1px solid #35415c; font-size:14px; font-weight:800; z-index:99999; box-shadow:0 8px 25px rgba(0,0,0,0.4); transition:opacity 0.2s;';
        document.body.appendChild(toast);
      }
      toast.innerText = msg;
      toast.style.opacity = '1';
      setTimeout(() => { toast.style.opacity = '0'; }, 3000);
    }

    function refreshAllViews() {
      renderTodayTable();
      renderBarriersBoard();
      renderAllLedger();
      populateComparisonDateSelectors();
      populateReportsDropdown();
      renderRecordsBoard(); // تحديث الأرقام القياسية
    }

    window.onload = function() {
      const savedTheme = localStorage.getItem(THEME_KEY) || 'dark';
      document.documentElement.setAttribute('data-theme', savedTheme);
      const btn = document.getElementById('themeToggleBtn');
      if (btn) btn.innerHTML = savedTheme === 'dark' ? '<i class="fa-solid fa-sun"></i> <span>الوضع النهاري</span>' : '<i class="fa-solid fa-moon"></i> <span>الوضع الليلي</span>';

      onCategoryChanged();
      loadDiagTestContent();
      refreshAllViews();
      updateTimerLabel();
    };
  </script>
