    function renderBarriersBoard() {
      const container = document.getElementById('milestonesCardsContainer');
      const kpiGrid = document.getElementById('trackKpiGrid');
      const countBadge = document.getElementById('barriersCountBadge');
      if (!container) return;

      const filter = document.getElementById('selBarrierFilter')?.value || 'all';
      const allBarriers = getDB().filter(r => r.category === 'barrier');

      let filtered = allBarriers;
      if (filter !== 'all') filtered = filtered.filter(r => r.track === filter);

      if (kpiGrid) {
        kpiGrid.innerHTML = '';
        const tracks = ['مساق حفظ القرآن الكريم', 'مساق حفظ الحديث الشريف', 'مساق حفظ موسوعة اللغات', 'مساق حفظ المواد الدراسية'];
        tracks.forEach(tName => {
          const tAttempts = allBarriers.filter(r => r.track === tName && r.status === 'مقبول');
          const brokenSet = new Set(tAttempts.map(r => r.barrierName));
          const best = [...tAttempts].sort((a,b) => (a.actTime||999) - (b.actTime||999))[0];

          const card = document.createElement('div');
          card.className = 'kpi-card';
          card.innerHTML = `
            <span class="kpi-label">${tName}</span>
            <span class="kpi-value">${brokenSet.size} / 12</span>
            <span class="kpi-subtext">أفضل وقت: ${best ? best.actTime + ' دقيقة (' + best.multiplier + ' ضعف)' : 'لم يبدأ بعد'}</span>
          `;
          kpiGrid.appendChild(card);
        });
      }

      const passedAll = new Set(filtered.filter(r => r.status === 'مقبول').map(r => r.barrierName));
      if (countBadge) countBadge.innerText = `${passedAll.size} / 12 مكسور بنجاح`;

      container.innerHTML = '';
      ALL_12_BARRIERS.forEach(barrier => {
        const matches = filtered.filter(r => r.barrierName === barrier.name || (r.barrierName && r.barrierName.startsWith(barrier.shortName)));
        const passedAttempts = matches.filter(r => r.status === 'مقبول');
        const failedAttempts = matches.filter(r => r.status !== 'مقبول');
        
        const isBroken = passedAttempts.length > 0;
        const best = isBroken ? passedAttempts.sort((a,b) => (a.actTime||999) - (b.actTime||999))[0] : null;

        const overAchievementHtml = (isBroken && best && best.actTime < barrier.targetMins) ? 
            `<div style="color: var(--accent-info); font-weight:800; font-size:12px; margin-top:6px;"><i class="fa-solid fa-rocket"></i> تفوق زمني! كُسر بـ ${best.actTime}د (الهدف ${barrier.targetMins}د)</div>` : '';

        const card = document.createElement('div');
        card.className = `milestone-card ${isBroken ? 'broken' : ''}`;
        card.innerHTML = `
          <div class="milestone-header">
            <div class="milestone-icon"><i class="fa-solid ${barrier.icon}"></i></div>
            <span class="badge ${isBroken ? 'success' : (matches.length > 0 ? 'warning' : 'neutral')}">
              ${isBroken ? 'تم الكسر بنجاح 🏆' : (matches.length > 0 ? 'قيد المحاولة ⏳' : 'لم يبدأ بعد')}
            </span>
          </div>
          <div>
            <div style="font-weight: 900; font-size: 15px; color: var(--text-main);">${barrier.name}</div>
            <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px; font-weight:600;">الهدف: ${barrier.targetMins} دقيقة للصفحة</div>
            ${overAchievementHtml}
          </div>
          
          <div style="display:flex; justify-content:space-between; align-items:center; border-top: 1px solid var(--border-color); padding-top: 10px; margin-top:4px;">
            ${isBroken && best ? `
              <div style="font-size: 12px; width:100%;">
                <div style="display:flex; justify-content:space-between; font-family:monospace; margin-bottom:4px;">
                  <span>وقت الكسر: <strong style="color:var(--accent-success);">${best.actTime}د</strong></span>
                  <span>المضاعفة: <strong>${best.multiplier} ضعف</strong></span>
                </div>
                <div style="display:flex; justify-content:space-between; color:var(--text-dim); font-size:11px;">
                  <span>الإتقان: ${best.accuracy}%</span>
                  <span style="color: var(--accent-danger); font-weight:700;">إخفاقات للكسر: ${failedAttempts.length}</span>
                </div>
              </div>
            ` : `
              <div style="font-size:12px; color:var(--text-dim); width:100%; display:flex; justify-content:space-between;">
                <span>${barrier.desc}</span>
                ${failedAttempts.length > 0 ? `<span style="color: var(--accent-danger); font-weight:800;">إخفاقات: ${failedAttempts.length}</span>` : ''}
              </div>
            `}
          </div>
        `;
        container.appendChild(card);
      });
    }

    function renderAllLedger() {
      const tbody = document.getElementById('ledgerTableBody');
