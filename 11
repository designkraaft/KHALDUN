    function runDayComparison() {
      const d1 = document.getElementById('selDate1')?.value;
      const d2 = document.getElementById('selDate2')?.value;
      const area = document.getElementById('compareResultsArea');
      if (!area || !d1 || !d2) return;

      const db = getDB();
      const r1 = db.filter(r => r.date === d1);
      const r2 = db.filter(r => r.date === d2);

      const sum1 = { quran: sumPages(r1, 'القرآن'), study: sumPages(r1, 'المواد الدراسية'), words: sumWords(r1), count: r1.length };
      const sum2 = { quran: sumPages(r2, 'القرآن'), study: sumPages(r2, 'المواد الدراسية'), words: sumWords(r2), count: r2.length };

      area.innerHTML = `
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: 16px;">
          <div class="kpi-card">
            <span class="kpi-label">صفحات القرآن الكريم</span>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:6px;">
              <span class="kpi-value">${sum1.quran} ص</span>
              <span style="font-size:13px; color:var(--text-muted); font-weight:700;">${d2}: ${sum2.quran} ص</span>
            </div>
            <div style="margin-top:6px;">${renderDeltaBadge(sum1.quran - sum2.quran, 'ص')}</div>
          </div>

          <div class="kpi-card">
            <span class="kpi-label">صفحات المواد الدراسية</span>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:6px;">
              <span class="kpi-value">${sum1.study} ص</span>
              <span style="font-size:13px; color:var(--text-muted); font-weight:700;">${d2}: ${sum2.study} ص</span>
            </div>
            <div style="margin-top:6px;">${renderDeltaBadge(sum1.study - sum2.study, 'ص')}</div>
          </div>

          <div class="kpi-card">
            <span class="kpi-label">كلمات اللغات</span>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:6px;">
              <span class="kpi-value">${sum1.words}</span>
              <span style="font-size:13px; color:var(--text-muted); font-weight:700;">${d2}: ${sum2.words}</span>
            </div>
            <div style="margin-top:6px;">${renderDeltaBadge(sum1.words - sum2.words, 'كلمة')}</div>
          </div>
        </div>
      `;
    }

    function sumPages(arr, trackMatch) {
      return arr.filter(r => r.track && r.track.includes(trackMatch) && r.pages).reduce((acc, r) => acc + r.pages, 0);
    }
    function sumWords(arr) {
      return arr.filter(r => r.words).reduce((acc, r) => acc + r.words, 0);
    }
    function renderDeltaBadge(diff, unit) {
      if (diff > 0) return `<span class="delta-meter delta-up">+${diff} ${unit} زيادة ⬆️</span>`;
      if (diff < 0) return `<span class="delta-meter delta-down">${diff} ${unit} نقصان ⬇️</span>`;
      return `<span class="delta-meter delta-eq">ثبات الأداء (=)</span>`;
    }

